# ProspectPilot Pro - exemple production
# App Fly réelle : prospectpilot-pro-ariane (voir fly.toml) — les URLs ci-dessous
# utilisent donc son domaine Fly réel, pas un nom générique à deviner.

DJANGO_SECRET_KEY=remplace-moi-par-une-cle-longue-aleatoire-de-plus-de-50-caracteres
DEBUG=False
ALLOWED_HOSTS=prospectpilot-pro-ariane.fly.dev
CSRF_TRUSTED_ORIGINS=https://prospectpilot-pro-ariane.fly.dev
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=3600
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
PUBLIC_BASE_URL=https://prospectpilot-pro-ariane.fly.dev

# En production Fly, DATABASE_URL et REDIS_URL sont généralement fournis
# automatiquement par les add-ons (`fly postgres attach`, Upstash Redis) et
# injectés comme secrets — ne les définis manuellement ici que si tu gères
# ta propre instance. Valeurs ci-dessous : uniquement pour docker-compose local.
DATABASE_URL=postgresql://prospectpilot:prospectpilot@db:5432/prospectpilot
REDIS_URL=redis://redis:6379/0

INITIAL_ADMIN_USERNAME=ariane
INITIAL_ADMIN_PASSWORD=mot-de-passe-admin-a-changer
INITIAL_ADMIN_EMAIL=

PAGESPEED_API_KEY=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://prospectpilot-pro-ariane.fly.dev/integrations/search-console/callback/
USER_AGENT=ProspectPilotBot/4.0 (+https://prospectpilot-pro-ariane.fly.dev/bot)
CRAWL_MAX_PAGES=12
CRAWL_DELAY_SECONDS=0.6
SEARCH_SCAN_SECONDS=25
SEARCH_SCAN_MAX_RESULTS=25
SEARCH_SCAN_CRAWL_PAGES=3
SEARCH_SITE_CANDIDATES=6
SEARCH_IMPORT_MAX_RESULTS=75

# ==========================================================================
# Messagerie — compte SMTP unique de l'application (OVH). Cette adresse est
# l'identité commerciale PredictNeed IA déjà validée (voir plus bas) ; les
# anciens envois d'auto-promotion ProspectPilot (prospects/services/emailing.py,
# fonction de secours sans produit configuré) utilisent aussi ce compte.
# ==========================================================================
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=ssl0.ovh.net
EMAIL_PORT=465
EMAIL_USE_SSL=True
EMAIL_USE_TLS=False
EMAIL_HOST_USER=contact-predict@predictneed-ia.com
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=PredictNeed IA <contact-predict@predictneed-ia.com>
EMAIL_SENDER_NAME=PredictNeed IA
CONTACT_EMAIL=contact-predict@predictneed-ia.com
# Identité légale de ProspectPilot Pro lui-même (utilisée uniquement par
# l'ANCIEN template d'auto-promotion ProspectPilot — pas par les campagnes
# PredictNeed). Laissée vide : ne pas inventer de raison sociale/adresse.
COMPANY_NAME=
COMPANY_POSTAL_ADDRESS=
EMAIL_BATCH_LIMIT=20
# Sélecteur DKIM (ex. "ovh" ou celui fourni par l'hébergeur) — sert uniquement
# au diagnostic affiché dans Réglages > Email PredictNeed IA, ne configure rien.
EMAIL_DKIM_SELECTOR=

# Lien utilisé dans le bouton du template d'auto-promotion ProspectPilot (legacy).
PRODUCT_URL=https://prospectpilot-pro-ariane.fly.dev

# APIs B2B optionnelles
DROPCONTACT_API_KEY=
APOLLO_API_KEY=
KASPR_API_KEY=
LEMLIST_API_KEY=

# ==========================================================================
# Moteur d'acquisition PredictNeed IA (mission 1)
# ==========================================================================
SEARCH_API_MIN_INTERVAL=0.25
ACQUISITION_PRESCORE_TOP_RATIO=0.25
ACQUISITION_SITE_CONFIDENCE_THRESHOLD=55
ACQUISITION_QUICK_SCAN_PAGES=5
ACQUISITION_DOMAIN_DELAY_SECONDS=1.0
ACQUISITION_SITE_CACHE_HOURS=72

# URLs publiques du produit PredictNeed IA (utilisées pour initialiser ProductProfile
# via `initialize_app` ; restent modifiables ensuite dans Réglages > Email PredictNeed IA).
PREDICTNEED_WEBSITE_URL=
PREDICTNEED_SIMULATOR_URL=
PREDICTNEED_SIGNUP_URL=
PREDICTNEED_PRICING_URL=
PREDICTNEED_MONTHLY_PRICE=99.00

# ==========================================================================
# API serveur-à-serveur ProspectPilot <-> PredictNeed IA (mission 1, ETAPE 20)
# ==========================================================================
PREDICTNEED_API_URL=
PREDICTNEED_SHARED_SECRET=
# Doit être IDENTIQUE à PROSPECTPILOT_SHARED_SECRET côté PredictNeed IA.
PROSPECTPILOT_SHARED_SECRET=
PROSPECTPILOT_PUBLIC_API_URL=https://prospectpilot-pro-ariane.fly.dev

# ==========================================================================
# Identité e-mail PredictNeed IA (mission 2)
# ==========================================================================
# Whitelist des identités d'expédition autorisées (séparées par des virgules).
# Tant que ce n'est pas configuré, aucune restriction supplémentaire n'est appliquée.
ALLOWED_SENDER_IDENTITIES=contact-predict@predictneed-ia.com

PREDICTNEED_SENDER_EMAIL=contact-predict@predictneed-ia.com
PREDICTNEED_REPLY_TO_EMAIL=contact-predict@predictneed-ia.com
EMAIL_SENDER_NAME_PREDICTNEED=PredictNeed IA
PREDICTNEED_LOGO_URL=
PREDICTNEED_CONTACT_URL=

# Informations de conformité PredictNeed IA (EmailComplianceProfile) — NE JAMAIS
# inventer ces valeurs. Laisser vide tant qu'elles ne sont pas fournies/validées.
COMPANY_LEGAL_NAME=
COMPANY_POSTAL_ADDRESS_PREDICTNEED=
COMPANY_COUNTRY=
COMPANY_REGISTRATION_NUMBER=
CONTACT_EMAIL_PREDICTNEED=contact-predict@predictneed-ia.com
PRIVACY_CONTACT_EMAIL=
DPO_EMAIL=
PRIVACY_POLICY_URL=
LEGAL_NOTICE_URL=
DATA_RIGHTS_URL=
DEFAULT_LEGAL_BASIS=

# Le compte SMTP OVH contact-predict@predictneed-ia.com est déjà la valeur
# d'exemple de la section "Messagerie" en haut de ce fichier (EMAIL_HOST_USER,
# DEFAULT_FROM_EMAIL, EMAIL_SENDER_NAME, CONTACT_EMAIL) — rien à dupliquer ici.
